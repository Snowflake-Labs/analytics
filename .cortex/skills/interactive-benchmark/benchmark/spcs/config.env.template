# SPCS deployment configuration for the benchmark API + locust load test.
# Sourced by every script under spcs/.  Edit values before running deploy.sh.

# --- Snowflake connection ---------------------------------------------------
# Must exist in `cortex connections list` and have SPCS privileges
# (create compute pool, create service).
CONNECTION=PM

# Role used when running the deploy SQL. Must be able to create the objects
# below and own the resulting services.
ROLE=SYSADMIN

# Warehouse used for the deploy SQL session itself (not the runtime warehouse
# used by the benchmark queries — that one is picked per request).
DEPLOY_WAREHOUSE=COMPUTE_WH

# --- Solution name (all object names are derived from this) ----------------
# Loaded from the project-level .env file.
# shellcheck disable=SC1091
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/benchmark/.env"
SOLUTION_NAME=${SOLUTION_NAME:?Error: SOLUTION_NAME is not set. Set it in benchmark/.env.}

# --- Object names -----------------------------------------------------------
DB=${SOLUTION_NAME}_DB
SCHEMA=SPCS

# Benchmark API server that executes queries against the interactive warehouse.
API_SERVICE=BENCHMARK_API
# Locust load-generator service.
LOCUST_SERVICE=BENCHMARK_LOCUST

# --- Container images -------------------------------------------------------
# Both services run the same approved image with different BENCHMARK_ROLE
# values. Keep the immutable tag pinned for reproducible benchmark runs.
# The skill requires 0.2.0 or later; deploy preflight rejects older tags.
IMAGE_DB=SNOWFLAKE
IMAGE_SCHEMA=IMAGES
IMAGE_REPO=SNOWFLAKE_IMAGES
BENCHMARK_IMAGE=interactive-analytics/interactive-benchmark
IMAGE_TAG=0.3.0
BENCHMARK_IMAGE_ARCH=amd64

# Internal stage for benchmark .sql files (mounted into the API container).
QUERIES_STAGE=BENCHMARK_QUERIES

# --- Compute pools ----------------------------------------------------------
# The API and Locust services run on independent compute pools so they can be
# sized without affecting each other.
API_COMPUTE_POOL=${SOLUTION_NAME}_API_POOL
API_INSTANCE_FAMILY=CPU_X64_M
API_MIN_NODES=1
API_MAX_NODES=4
API_MIN_INSTANCES=3
API_MAX_INSTANCES=3

LOCUST_COMPUTE_POOL=${SOLUTION_NAME}_LOCUST_POOL
LOCUST_INSTANCE_FAMILY=CPU_X64_M
LOCUST_MIN_NODES=1
LOCUST_MAX_NODES=2

# --- API runtime ------------------------------------------------------------
# Snowflake database the benchmark queries run against.
API_DATABASE=${SOLUTION_NAME}_DB
# SPCS service users can use the service owner role (ROLE) or PUBLIC.
API_ROLE=${ROLE}
# Fallback warehouse if a query does not specify one.
API_WAREHOUSE=COMPUTE_WH
API_PORT=3000
POOL_SIZE=50

# --- API tuning (higher = more concurrency) --------------------------------
API_WORKERS=4
API_POOL_WARMUP=10
API_POOL_ACQUIRE_TIMEOUT=30

# --- API container resources (must be >= API_WORKERS cores) ----------------
API_CPU_REQUEST=2000m
API_CPU_LIMIT=4000m
API_MEMORY_REQUEST=2Gi
API_MEMORY_LIMIT=4Gi

# Interactive warehouse and schema used by the benchmark.
INTERACTIVE_WAREHOUSE=${SOLUTION_NAME}_INT_WH
INTERACTIVE_SCHEMA=TPCH_SF100_INT

# --- Locust runtime ---------------------------------------------------------
# Locust targets the API service via internal SPCS DNS.
# NOTE: SPCS internal DNS lowercases the service name AND converts every
# underscore to a hyphen (see docs: ECHO_SERVICE -> echo-service...).
# So BENCHMARK_API resolves as benchmark-api. LOCUST_HOST is derived from
# API_SERVICE and API_PORT so it cannot drift from them.
#
# The container runs locust in non-headless mode with --autostart --autoquit,
# so the swarm begins automatically when the container starts, ramps up,
# measures LOCUST_RUN_TIME of full load, and then locust quits. No external
# HTTP call is required.
LOCUST_HOST="http://$(tr '[:upper:]_' '[:lower:]-' <<<"$API_SERVICE"):${API_PORT}"
LOCUST_WEB_PORT=8089
LOCUST_USERS=50
LOCUST_SPAWN=5
LOCUST_RUN_TIME=3m
API_READY_TIMEOUT_SECONDS=600
API_READY_POLL_SECONDS=2

# Baseline gate on the no-op endpoint: the load test only runs if the
# baseline stays within these limits.
BASELINE_MAX_P99_MS=500
BASELINE_MAX_FAILURE_PCT=1

# The benchmark phase reports [benchmark] VERDICT: FAIL above this failure %.
BENCHMARK_MAX_FAILURE_PCT=1
