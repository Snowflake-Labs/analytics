# Example environment file for the SSB (Star Schema Benchmark). Copy to .env and adjust.
CONNECTION_NAME=DEFAULT

# Solution name — all Snowflake object names are derived from this:
#   Database:              <SOLUTION_NAME>_BENCH_DB
#   Schema (source views): SSB_SF<SCALE>_SRC       (fixed, not derived)
#   Schema (standard):     SSB_SF<SCALE>           (fixed, not derived)
#   Schema (interactive):  SSB_SF<SCALE>_IT        (fixed, not derived)
#   Schema (iceberg):      SSB_SF<SCALE>_ICE       (fixed, not derived)
#   Load warehouse:        <SOLUTION_NAME>_BENCH_WH_LOAD
#   Standard warehouse:    <SOLUTION_NAME>_BENCH_WH_STD_<SCALE>
#   Interactive warehouse: <SOLUTION_NAME>_BENCH_WH_INT_<SCALE>
# Can also be overridden per-run via --solution CLI flag.
SOLUTION_NAME=SSB

# Default SSB scale factor: 1, 10, 100, or 1000
DEFAULT_SCALE=10

# External volume for Iceberg tables. Set to a volume name, or "auto" to use
# the account-level default (SHOW PARAMETERS LIKE 'EXTERNAL_VOLUME' IN ACCOUNT).
ICEBERG_EXTERNAL_VOLUME=auto
