{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iwb-config.schema.json",
  "title": "Interactive benchmark run config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context",
    "workload",
    "warehouse",
    "concurrent_users",
    "run_minutes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,30}$",
      "description": "Optional run label; defaults to a generated run id."
    },
    "context": {
      "$ref": "#/$defs/context",
      "description": "Database/schema the queries run in. Required; per-query context (SQL texts) overrides it."
    },
    "workload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query_ids"
          ],
          "properties": {
            "query_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/query_id"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "query_id"
                    ],
                    "properties": {
                      "query_id": {
                        "$ref": "#/$defs/query_id"
                      },
                      "weight_pct": {
                        "$ref": "#/$defs/weight_pct"
                      }
                    }
                  }
                ]
              },
              "description": "Plain IDs get equal weight. If any weight is given, all must be, summing to 100."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queries"
          ],
          "properties": {
            "queries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sql",
                  "weight_pct"
                ],
                "properties": {
                  "sql": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000000
                  },
                  "weight_pct": {
                    "$ref": "#/$defs/weight_pct"
                  },
                  "context": {
                    "$ref": "#/$defs/context"
                  }
                }
              },
              "description": "weight_pct values must sum to 100 (validated by the controller, not expressible in JSON Schema)."
            }
          }
        }
      ]
    },
    "warehouse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existing"
          ],
          "properties": {
            "existing": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
              "description": "Interactive warehouse to benchmark. Never altered or dropped; if suspended, it is resumed for the run and suspended again afterwards. Interactive tables the workload reads must already be attached; unattached standard tables work but are not cached."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create"
          ],
          "properties": {
            "create": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "size"
              ],
              "properties": {
                "size": {
                  "enum": [
                    "XSMALL",
                    "SMALL",
                    "MEDIUM",
                    "LARGE",
                    "XLARGE",
                    "XXLARGE",
                    "XXXLARGE",
                    "X4LARGE"
                  ]
                },
                "min_cluster_count": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "max_cluster_count": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                }
              },
              "description": "Created with the tables the workload reads attached, and dropped when the run ends (including on failure)."
            }
          }
        }
      ]
    },
    "fallback_warehouse": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
      "description": "Optional standard warehouse for statements that hit the 5 s interactive timeout. Without it those statements fail and count against the failure gate."
    },
    "lookup_warehouse": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
      "description": "Standard warehouse used only to look up workload.query_ids in query history. Needed when the user has no DEFAULT_WAREHOUSE; not allowed with workload.queries."
    },
    "concurrent_users": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "run_minutes": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 240
    }
  },
  "$defs": {
    "query_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "weight_pct": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "schema"
      ],
      "properties": {
        "database": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
