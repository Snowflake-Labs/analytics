# Snowflake connection + deploy session
CONNECTION=DEFAULT
ROLE=ACCOUNTADMIN
DEPLOY_WAREHOUSE=COMPUTE_WH

# Solution naming (derives DB, image repo, pool names).
# Should match SOLUTION_NAME in tpc-h-sample-dashboard/.env.
SOLUTION_NAME=IW_TPCH

# SPCS infra location
DB=${SOLUTION_NAME}_BENCH_DB
SCHEMA=SPCS
IMAGE_REPO=${SOLUTION_NAME}_BENCH_IMAGES

# Compute pools
DASHBOARD_COMPUTE_POOL=${SOLUTION_NAME}_BENCH_DASHBOARD_POOL
DASHBOARD_INSTANCE_FAMILY=CPU_X64_M
DASHBOARD_MIN_NODES=1
DASHBOARD_MAX_NODES=4

LOCUST_COMPUTE_POOL=${SOLUTION_NAME}_BENCH_LOCUST_POOL
LOCUST_INSTANCE_FAMILY=CPU_X64_M
LOCUST_MIN_NODES=1
LOCUST_MAX_NODES=2

# Service names (fixed; matches skill docs)
DASHBOARD_SERVICE=DASHBOARD
LOCUST_API_SERVICE=DASHBOARD_API_LOCUST
LOCUST_SERVICE=DASHBOARD_LOCUST

# Images
DASHBOARD_IMAGE=dashboard
LOCUST_IMAGE=locust
IMAGE_TAG=latest

# Build method for build-and-push.sh / update.sh:
#   spcs   - build server-side via `snow spcs service build-image` (default,
#            no local Docker daemon needed)
#   docker - local `docker build` + `docker push` (needs Docker Desktop/buildx
#            and `snow spcs image-registry login`)
BUILD_METHOD=spcs
# Compute pool the build-image job runs on (BUILD_METHOD=spcs only).
# Defaults to DASHBOARD_COMPUTE_POOL below if left unset.
BUILD_COMPUTE_POOL=${SOLUTION_NAME}_BENCH_DASHBOARD_POOL
# Space-separated external access integration name(s) the build-image job
# needs for network egress — both Dockerfiles run apt-get/curl/uv sync, which
# need internet access. Required for BUILD_METHOD=spcs on most accounts; see
# CREATE EXTERNAL ACCESS INTEGRATION in the Snowflake docs. Example:
#   BUILD_EAI_NAME=ALLOW_ALL_EAI
BUILD_EAI_NAME=

# Scale of TPC-H data the dashboard queries
DEFAULT_SCALE=100

# Dashboard container runtime
DASHBOARD_DATABASE=${DB}
DASHBOARD_ROLE=ACCOUNTADMIN
DASHBOARD_WAREHOUSE=${SOLUTION_NAME}_BENCH_WH_INT_${DEFAULT_SCALE}
DASHBOARD_DEFAULT_SCALE=${DEFAULT_SCALE}
DASHBOARD_PORT=3000

# Dashboard API tuning (higher = more concurrency)
DASHBOARD_WORKERS=4
DASHBOARD_POOL_SIZE=40
DASHBOARD_POOL_WARMUP=10
DASHBOARD_POOL_ACQUIRE_TIMEOUT=30

# Dashboard container resources (must be >= WORKERS cores)
DASHBOARD_CPU_REQUEST=2000m
DASHBOARD_CPU_LIMIT=4000m
DASHBOARD_MEMORY_REQUEST=2Gi
DASHBOARD_MEMORY_LIMIT=4Gi

# SPCS service scale-out (dashboard only; locust services stay at 1)
DASHBOARD_MIN_INSTANCES=1
DASHBOARD_MAX_INSTANCES=4

# Locust container runtime
LOCUST_HOST=http://dashboard-api-locust:3000
LOCUST_WEB_PORT=8089
LOCUST_USERS=10
LOCUST_SPAWN=5
LOCUST_HEADLESS=0
LOCUST_RUN_TIME=5m
LOCUST_WAREHOUSE=interactive
LOCUST_SCALE=${DEFAULT_SCALE}
